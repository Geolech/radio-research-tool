{
  "name": "hifi-app",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare:standalone": "node electron/prepare-standalone.js",
    "electron:dev": "electron .",
    "dist": "next build && node electron/prepare-standalone.js && electron-builder --win"
  },
  "build": {
    "appId": "de.thowl.radio-research-tool",
    "productName": "Radio Research Tool",
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RadioResearchTool-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "RadioResearchTool-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.106.2",
    "@types/page-flip": "^2.0.4",
    "next": "16.2.4",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^5.7.284",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
